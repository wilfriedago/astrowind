        },
        {
          "type": "text",
          "id": "n62Pbc",
          "x": 479,
          "y": 398,
          "name": "Bio",
          "fill": "#FFFFFF99",
          "textGrowth": "fixed-width",
          "width": 530,
          "content": "Detail-oriented software engineer who enjoys turning messy problems into simple, well-tested systems.\nI believe great software comes from understanding a problem down to its core.\n\nI specialize in full-stack web development with TypeScript, Go and cloud-native tooling. I design APIs, build responsive interfaces, and care about performance, accessibility and developer experience. I also enjoy CI/CD automation, infrastructure as code, and contributing to open source.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },
