---
import { site } from '../data/site';
import Icon from './Icon.astro';
import Socials from './Socials.astro';

const links = [
	{ label: 'Introduction', href: '/#introduction' },
	{ label: 'Projects', href: '/#projects' },
	{ label: 'About', href: '/#about' },
	{ label: 'Contact', href: '/#contact' },
	{ label: 'All work', href: '/projects/' },
];
---

<header class="header">
	<a href="/" class="logo" aria-label={`${site.name} — home`}>
		{site.monogram.map((row) => <span>{row}</span>)}
	</a>
	<button
		class="glass-button"
		type="button"
		aria-haspopup="dialog"
		aria-controls="site-menu"
		data-menu-open
	>
		<Icon name="menu" />
		<span class="visually-hidden">Open menu</span>
	</button>
</header>

<dialog id="site-menu" class="menu" aria-label="Site menu">
	<div class="menu-inner">
		<button class="glass-button menu-close" type="button" data-menu-close>
			<Icon name="x" />
			<span class="visually-hidden">Close menu</span>
		</button>
		<nav aria-label="Main">
			<ol class="menu-links">
				{
					links.map((link, i) => (
						<li>
							<a href={link.href} data-menu-link>
								<span class="menu-index">/{String(i + 1).padStart(2, '0')}</span>
								{link.label}
							</a>
						</li>
					))
				}
			</ol>
		</nav>
		<Socials />
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
	const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');

	openButton?.addEventListener('click', () => dialog?.showModal());
	dialog?.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());

	// Close after picking a link so in-page anchors scroll into view.
	dialog?.querySelectorAll('[data-menu-link]').forEach((link) => {
		link.addEventListener('click', () => dialog.close());
	});

	// Click on the backdrop closes the menu.
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});
</script>

<style>
	.header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 30;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		padding: calc(1.75rem + env(safe-area-inset-top, 0px)) var(--gutter) 0;
		pointer-events: none;
	}

	.header > * {
		pointer-events: auto;
	}

	.logo {
		display: grid;
		padding-top: 0.375rem;
		font-size: 0.6875rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: 5px;
	}

	.menu {
		width: 100%;
		max-width: 100%;
		height: 100%;
		max-height: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		color: var(--c-text);
		background: var(--c-scrim);
		backdrop-filter: blur(16px);
	}

	.menu::backdrop {
		background: transparent;
	}

	.menu[open] {
		animation: fade-in 300ms var(--ease-out);
	}

	.menu-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 3rem;
		min-height: 100%;
		padding: 6rem var(--gutter) 4rem var(--rail);
	}

	.menu-close {
		position: absolute;
		top: calc(1.75rem + env(safe-area-inset-top, 0px));
		right: var(--gutter);
	}

	.menu-links {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.menu-links a {
		display: inline-flex;
		align-items: baseline;
		gap: 1.25rem;
		font-size: clamp(2rem, 6vw, 3rem);
		font-weight: 500;
		color: var(--c-subtle);
		transition: color 200ms ease;
	}

	.menu-links a:hover,
	.menu-links a:focus-visible {
		color: var(--c-text);
	}

	.menu-index {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 400;
		color: var(--c-dim);
	}

	@keyframes fade-in {
		from {
			opacity: 0;
		}
	}
</style>
